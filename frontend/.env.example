# Gateway base URL. Defaults to the local backend (http://localhost:8080)
# when unset. Point at production with one line:
# VITE_THRU_API_BASE=https://thru-backend.<region>.azurecontainerapps.io

# Needed only for local, trusted teaching demos (POST /teach is admin-gated
# and this must match the backend's THRU_ADMIN_KEY). Vite embeds every
# VITE_* value in the browser bundle: never set this in a public deployment.
# VITE_THRU_ADMIN_KEY=
