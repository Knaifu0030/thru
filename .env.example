PORT=8080
THRU_ALLOWED_ORIGINS=https://your-marketplace.vercel.app
THRU_ADMIN_KEY=replace-with-an-azure-container-app-secret
THRU_RUNS_FILE=data/runs.json
THRU_KEYS_FILE=data/keys.json
THRU_TEACHING_FILE=data/teaching-sessions.json
THRU_SESSIONS_FILE=data/sessions.json
THRU_APPROVALS_FILE=data/approvals.json
THRU_RUN_RETENTION_DAYS=30
THRU_RATE_LIMIT_PER_MINUTE=120
THRU_QUEUE_MAX_DEPTH=100
# Optional managed PostgreSQL persistence. Azure production supplies this via a secret reference.
# THRU_DATABASE_URL=postgresql://user:password@host:5432/thru?sslmode=require
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=replace-with-an-azure-container-app-secret
AZURE_OPENAI_DEPLOYMENT=replace-with-deployment-name
AZURE_OPENAI_API_VERSION=2024-10-21
