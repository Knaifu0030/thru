{
  "forge_spec": 1,
  "skill": {
    "id": "hell-check",
    "name": "Check Demoland Certificate",
    "description": "Checks a certificate on THRU's deliberately fragile legacy portal.",
    "site": {
      "domain": "thru-internal",
      "display": "Demoland Certificate Portal"
    },
    "version": 1,
    "forged_at": "2026-08-22T09:00:00+05:30",
    "author": {
      "name": "THRU",
      "id": "local"
    },
    "tags": [
      "demo",
      "certificate",
      "status-check"
    ],
    "sensitive": false
  },
  "contract": {
    "inputs": {
      "type": "object",
      "properties": {
        "certificate": {
          "type": "string",
          "pattern": "^[A-Z0-9-]{4,12}$",
          "description": "Certificate reference"
        }
      },
      "required": [
        "certificate"
      ]
    },
    "outputs": {
      "type": "object",
      "properties": {
        "certificate": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "holder": {
          "type": "string"
        },
        "issued_on": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "render_hint": "keyvalue"
  },
  "workflow": {
    "engine": "webcmd",
    "steps": [
      {
        "id": "s1",
        "action": "navigate",
        "target_description": "Demoland certificate status page",
        "url": "{site}/mock/hell-portal",
        "expect": {
          "contains": [
            "Certificate Status"
          ],
          "not_contains": [
            "maintenance",
            "login"
          ]
        },
        "timeout_ms": 15000,
        "sensitive": false
      },
      {
        "id": "s2",
        "action": "fill",
        "target_description": "Certificate number input",
        "selector_primary": "#certificate-number",
        "selector_fallbacks": [
          "input[name='certificate']",
          "#record-reference"
        ],
        "value_from": "inputs.certificate",
        "expect": {
          "field_value_equals": "inputs.certificate",
          "not_contains": [
            "captcha",
            "password"
          ]
        },
        "timeout_ms": 8000,
        "sensitive": false
      },
      {
        "id": "s3",
        "action": "click",
        "target_description": "Check certificate status button",
        "selector_primary": "#check-status",
        "selector_fallbacks": [
          "#verify-now"
        ],
        "expect": {
          "element_present": "#result-json",
          "not_contains": [
            "captcha",
            "payment"
          ]
        },
        "timeout_ms": 10000,
        "sensitive": false
      },
      {
        "id": "s4",
        "action": "extract",
        "target_description": "Certificate status result",
        "selector_primary": "#result-json",
        "selector_fallbacks": [],
        "extraction": {
          "strategy": "json_element",
          "map_to": "outputs",
          "selector": "#result-json"
        },
        "expect": {
          "contains": [
            "status"
          ],
          "not_contains": [
            "error"
          ]
        },
        "timeout_ms": 5000,
        "sensitive": false
      }
    ]
  },
  "vitals": {
    "runs": 0,
    "successes": 0,
    "healed_runs": 0,
    "avg_ms": 0,
    "last_run": null,
    "last_heal": null
  },
  "history": []
}
