{
  "forge_spec": 1,
  "skill": {
    "id": "nadakacheri-prepare-income",
    "name": "Prepare Demo Income Certificate",
    "description": "Prepares a fictional income-certificate application package on THRU's internal Nadakacheri demo portal.",
    "site": { "domain": "thru-internal", "display": "Fictional Nadakacheri Demo Portal" },
    "version": 1,
    "forged_at": "2026-08-22T10:00:00+05:30",
    "author": { "name": "THRU", "id": "local" },
    "tags": ["demo", "civic-tech", "income-certificate", "read-only"],
    "sensitive": false
  },
  "contract": {
    "inputs": {
      "type": "object",
      "properties": {
        "applicant_name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z .'-]{2,79}$", "description": "Fictional applicant name" },
        "date_of_birth": { "type": "string", "format": "date", "description": "Fictional date of birth" },
        "district": { "type": "string", "description": "Karnataka district used for the demo" },
        "taluk": { "type": "string", "description": "Taluk used for the demo" },
        "annual_income": { "type": "integer", "description": "Fictional annual income in INR" },
        "purpose": { "type": "string", "description": "Purpose for the demo certificate" },
        "identity_ready": { "type": "boolean", "description": "Fictional identity document is ready" },
        "address_ready": { "type": "boolean", "description": "Fictional address document is ready" },
        "income_ready": { "type": "boolean", "description": "Fictional income document is ready" },
        "photo_ready": { "type": "boolean", "description": "Fictional photo is ready" }
      },
      "required": ["applicant_name", "date_of_birth", "district", "taluk", "annual_income", "purpose", "identity_ready", "address_ready", "income_ready", "photo_ready"]
    },
    "outputs": {
      "type": "object",
      "properties": {
        "reference": { "type": "string" },
        "status": { "type": "string" },
        "prepared_at": { "type": "string" },
        "next_action": { "type": "string" }
      },
      "required": ["reference", "status", "prepared_at", "next_action"]
    },
    "render_hint": "keyvalue"
  },
  "workflow": {
    "engine": "webcmd",
    "steps": [
      { "id": "s1", "action": "navigate", "target_description": "Fictional income certificate preparation page", "url": "{site}/mock/nadakacheri/prepare", "expect": { "contains": ["Prepare an income certificate application"], "not_contains": ["login", "captcha"] }, "timeout_ms": 15000, "sensitive": false },
      { "id": "s2", "action": "fill", "target_description": "Applicant name", "selector_primary": "#applicant-name", "selector_fallbacks": ["input[name='applicant_name']", "label:Applicant name"], "value_from": "inputs.applicant_name", "expect": { "field_value_equals": "inputs.applicant_name", "not_contains": ["password", "otp"] }, "timeout_ms": 6000, "sensitive": false },
      { "id": "s3", "action": "fill", "target_description": "Date of birth", "selector_primary": "#date-of-birth", "selector_fallbacks": ["input[name='date_of_birth']", "label:Date of birth"], "value_from": "inputs.date_of_birth", "expect": { "field_value_equals": "inputs.date_of_birth", "not_contains": ["password", "otp"] }, "timeout_ms": 6000, "sensitive": false },
      { "id": "s4", "action": "fill", "target_description": "District", "selector_primary": "#district", "selector_fallbacks": ["select[name='district']", "label:District"], "value_from": "inputs.district", "expect": { "field_value_equals": "inputs.district", "not_contains": ["captcha"] }, "timeout_ms": 6000, "sensitive": false },
      { "id": "s5", "action": "fill", "target_description": "Taluk", "selector_primary": "#taluk", "selector_fallbacks": ["input[name='taluk']", "label:Taluk"], "value_from": "inputs.taluk", "expect": { "field_value_equals": "inputs.taluk", "not_contains": ["captcha"] }, "timeout_ms": 6000, "sensitive": false },
      { "id": "s6", "action": "fill", "target_description": "Annual income", "selector_primary": "#annual-income", "selector_fallbacks": ["input[name='annual_income']", "label:Annual income"], "value_from": "inputs.annual_income", "expect": { "field_value_equals": "inputs.annual_income", "not_contains": ["payment"] }, "timeout_ms": 6000, "sensitive": false },
      { "id": "s7", "action": "fill", "target_description": "Certificate purpose", "selector_primary": "#purpose", "selector_fallbacks": ["input[name='purpose']", "label:Purpose"], "value_from": "inputs.purpose", "expect": { "field_value_equals": "inputs.purpose", "not_contains": ["payment"] }, "timeout_ms": 6000, "sensitive": false },
      { "id": "s12", "action": "click", "target_description": "Prepare demo application button", "selector_primary": "#prepare-application", "selector_fallbacks": ["text:Prepare demo application", "button[type='button']"], "expect": { "element_present": "#result-json", "not_contains": ["government submission", "payment"] }, "timeout_ms": 8000, "sensitive": false },
      { "id": "s13", "action": "extract", "target_description": "Prepared application result", "selector_primary": "#result-json", "selector_fallbacks": ["pre"], "extraction": { "strategy": "json_element", "map_to": "outputs", "selector": "#result-json" }, "expect": { "contains": ["ready_for_submission"], "not_contains": ["error"] }, "timeout_ms": 5000, "sensitive": false }
    ]
  },
  "vitals": { "runs": 0, "successes": 0, "healed_runs": 0, "avg_ms": 0, "last_run": null, "last_heal": null },
  "history": []
}
